local CharacterConnection

local function ConnectCharacter(Character)

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    RespawnCount += 1

    LastPosition = nil
    LastHealth = nil

    local Humanoid = Character:WaitForChild(
        "Humanoid",
        10
    )

    local Root = Character:WaitForChild(
        "HumanoidRootPart",
        10
    )

    BuildAvatarPreview()
    UpdateInventory()

    if not Humanoid then
        return
    end

    CharacterConnection = Humanoid.HealthChanged:Connect(
        function(Health)

            LastHealth = Health

            local MaxHealth = Humanoid.MaxHealth

            if MaxHealth > 0 then
                local Percent = math.clamp(
                    Health / MaxHealth,
                    0,
                    1
                )

                HealthPercent.Text =
                    string.format(
                        "%.0f%%",
                        Percent * 100
                    )

                HealthText.Text =
                    string.format(
                        "HEALTH: %.0f / %.0f",
                        Health,
                        MaxHealth
                    )

                StateLabel.Text =
                    Health > 0
                    and "STATE: ALIVE"
                    or "STATE: DEAD"

                AliveLabel.Text =
                    Health > 0
                    and "STATUS: ALIVE"
                    or "STATUS: DEAD"
            end
        end
    )

    if Root then
        LastPosition = Root.Position
    end
end

