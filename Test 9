                else
                    AliveLabel.Text =
                        "STATUS: DEAD"

                    StateLabel.Text =
                        "STATE: DEAD"

                    AliveLabel.TextColor3 =
                        C.Red

                    StateLabel.TextColor3 =
                        C.Red
                end
            end
        end

        -- FPS
        FrameCounter += 1

        local Now = os.clock()

        if Now - FPSStart >= 1 then

            local FPS =
                FrameCounter /
                (Now - FPSStart)

            FPSLabel.Text =
                string.format(
                    "FPS: %.0f",
                    FPS
                )

            AddGraphPoint(
                FPSGraph,
                FPSPoints,
                FPS,
                120
            )

            FrameCounter = 0
            FPSStart = Now
        end

        -- Ping
        local Ping = 0

        pcall(function()
            Ping = Player:GetNetworkPing() * 1000
        end)

        if Ping > 0 then

            PingLabel.Text =
                string.format(
                    "PING: %.0f ms",
                    Ping
                )

            AddGraphPoint(
                PingGraph,
                PingPoints,
                Ping,
                300
            )

            if Ping >= 180 then

                if not LastPingWarning then
                    LastPingWarning = true

                    PingLabel.TextColor3 =
                        C.Red
                end

            else

                LastPingWarning = false

                PingLabel.TextColor3 =
                    C.White
            end
        end
    end
end)

