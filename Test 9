                Minutes,
                Seconds
            )

        RespawnStatsLabel.Text =
            "RESPAWNS: " .. tostring(
                math.max(0, RespawnCount - 1)
            )

        -- Position
        if Root then

            local Position = Root.Position

            PositionLabel.Text =
                string.format(
                    "X: %.1f   Y: %.1f   Z: %.1f",
                    Position.X,
                    Position.Y,
                    Position.Z
                )

            LastPosition = Position
        end

        -- Health
        if Humanoid then

            local Health = Humanoid.Health
            local MaxHealth = Humanoid.MaxHealth

            if MaxHealth > 0 then

                local Percent =
                    math.clamp(
                        Health / MaxHealth,
                        0,
                        1
                    )

                HealthPercent.Text =
                    string.format(
                        "%.0f%%",
                        Percent * 100
                    )

                HealthText.Text =
                    string.format(
