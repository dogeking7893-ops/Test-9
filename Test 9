local AvatarModel = nil
local AvatarAngle = 0
local AvatarDragging = false
local AvatarDragStart = nil

local function PrepareAvatarModel(Model)
    if not Model then
        return
    end

    for _, Item in ipairs(Model:GetDescendants()) do
        if Item:IsA("Script")
        or Item:IsA("LocalScript")
        or Item:IsA("ModuleScript") then
            Item:Destroy()

        elseif Item:IsA("BasePart") then
            Item.Anchored = true
            Item.CanCollide = false
        end
    end

    Model.Parent = AvatarWorld

    local Root = Model:FindFirstChild("HumanoidRootPart")

    if Root then
        Model.PrimaryPart = Root
    end
local Height = Model:GetExtentsSize().Y

AvatarCamera.CFrame = CFrame.lookAt(
    Vector3.new(
        0,
        Height * 0.48,
        math.max(4.5, Height * 1.15)
    ),
    Vector3.new(
        0,
        Height * 0.48,
        0
    )
)

AvatarModel = Model
 
end

local function BuildAvatarPreview()
    if AvatarModel then
        AvatarModel:Destroy()
        AvatarModel = nil
    end

    task.spawn(function()

        local Description

        local Success = pcall(function()
            Description =
                Players:GetHumanoidDescriptionFromUserIdAsync(
                    Player.UserId
                )
        end)

        if not Success or not Description then
            return
        end

        local Model

        local Created = pcall(function()
            Model =
                Players:CreateHumanoidModelFromDescriptionAsync(
                    Description,
                    Enum.HumanoidRigType.R15
                )
        end)

        if not Created or not Model then
            return
        end

        PrepareAvatarModel(Model)

        if AvatarModel then
            AvatarModel:PivotTo(
                CFrame.new(0, 0, 0)
                * CFrame.Angles(0, AvatarAngle, 0)
            )
        end
    end)
end

BuildAvatarPreview()

AvatarViewport.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        AvatarDragging = true
        AvatarDragStart = Input.Position
    end
end)

UIS.InputChanged:Connect(function(Input)

    if AvatarDragging and AvatarModel then

        if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then

            local Delta = Input.Position - AvatarDragStart

            AvatarDragStart = Input.Position
            AvatarAngle += Delta.X * 0.012

            AvatarModel:PivotTo(
                CFrame.new(0, 0, 0)
                * CFrame.Angles(0, AvatarAngle, 0)
            )
        end
    end
end)

UIS.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        AvatarDragging = false
    end
end)

