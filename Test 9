                        MaxHealth
                    )

                if Health > 0 then
                    AliveLabel.Text =
                        "STATUS: ALIVE"

                    StateLabel.Text =
                        "STATE: ALIVE"

                    AliveLabel.TextColor3 =
                        C.Green

                    StateLabel.TextColor3 =
