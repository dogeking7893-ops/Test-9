end

local function AddInventoryItem(Tool, Equipped)
    local Row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Equipped and C.Selected or C.Content,
        BackgroundTransparency = 0.2,
